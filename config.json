{
  "camera": {
    "device_id": 0,
    "target_width": 1280,
    "target_height": 720,
    "target_fps": 30,
    "backend": "ds_any"
  },
  "performance": {
    "frame_queue_size": 4,
    "fps_limit": 15
  },
  "recognition": {
    "device": "auto",
    "model_name": "vggface2",
    "face_size": 160,
    "use_alignment": true,
    "apply_clahe": false,
    "similarity_threshold": 0.65,
    "detection_interval": 5,
    "max_samples_per_user": 5
  },
  "tracking": {
    "min_face_size": 60,
    "max_disappeared": 15,
    "iou_threshold": 0.3,
    "use_hungarian": true
  },
  "database": {
    "path": "facescan_db",
    "save_face_images": true
  },
  "web_api": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 5050,
    "auth_token": ""
  },
  "logging": {
    "level": "INFO",
    "file": "logs/facescan.log",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "debug": {
    "draw_landmarks": false
  }
}
