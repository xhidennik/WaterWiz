### Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

### Database
# Default: SQLite in project root (db.sqlite3)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL (example):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=waterwiz
# DB_USER=waterwiz
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

### Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
SERVER_LOG_LEVEL=INFO
ERRORS_LOG_LEVEL=ERROR

# Slow pages threshold (used in tests)
SLOW_PAGE_THRESHOLD_MS=500

### FaceID
# URL of the FaceID API server (python manage.py faceid_api)
FACEID_API_URL=http://127.0.0.1:5050
# Cosine similarity threshold (0.0-1.0)
FACEID_SIMILARITY_THRESHOLD=0.65
# HTTP request timeout in seconds
FACEID_REQUEST_TIMEOUT=5

# File paths can be absolute or relative to BASE_DIR
SERVER_LOG_FILE=logs/server.log
DJANGO_LOG_FILE=logs/django.log
ERRORS_LOG_FILE=logs/errors.log

